# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ticketing_system

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_me_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_me_in_production_32chars
JWT_REFRESH_EXPIRES_IN=7d

# Two-Way Email & Threading Security
EMAIL_HMAC_SECRET=your_email_hmac_secret_for_reply_tokens_change_in_production
EMAIL_INBOUND_DOMAIN=support.yourdomain.com
EMAIL_FROM="Support Team <support@yourdomain.com>"
EMAIL_WEBHOOK_SECRET=your_webhook_signature_secret_or_bearer_token

# SMTP Outbound Email Provider
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Uploads Configuration
UPLOAD_MAX_FILE_SIZE_MB=5
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain
