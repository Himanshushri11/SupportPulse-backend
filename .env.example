# ========================================================
# SupportPulse Backend Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://supportpulse-backend.onrender.com
FRONTEND_URL=https://support-pulse-frontend.vercel.app

# Database (MongoDB Atlas for Production)
# Example: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/ticketing_system?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ticketing_system?retryWrites=true&w=majority

# JWT Authentication Secrets (Must be 32+ characters long secure random strings)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_me_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_me_in_production_32chars
JWT_REFRESH_EXPIRES_IN=7d

# Brevo API & Email Sending Configuration
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM="SupportPulse Support <support@yourdomain.com>"
ADMIN_SUPPORT_EMAIL=admin@yourdomain.com

# SMTP Fallback Configuration (if using standard SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@domain.com
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM="SupportPulse Support <support@yourdomain.com>"
SMTP_SECURE=false

# Two-Way Email & Threading Security
EMAIL_HMAC_SECRET=your_email_hmac_secret_for_reply_tokens_change_in_production
EMAIL_INBOUND_DOMAIN=support.yourdomain.com
EMAIL_WEBHOOK_SECRET=your_webhook_signature_secret_or_bearer_token

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=50

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Uploads Configuration
UPLOAD_MAX_FILE_SIZE_MB=5
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain

# Twilio (SMS Verification - Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
